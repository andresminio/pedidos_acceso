out/
build/

# Variables de entorno / credenciales — nunca versionar
.env
.env.local
.env.*.local
mail-bot/.env

# Datos importados puntuales (cargas masivas a mano vía SQL editor) — no
# son parte del esquema, no hace falta versionarlos.
supabase/import_homologados.sql

# Migraciones puntuales ya aplicadas a la base — schema.sql y los demás
# schema_*.sql ya reflejan el estado final, así que estas quedan como
# referencia histórica en el disco pero no hace falta seguir versionándolas.
supabase/migration_*.sql

# Planillas y documentos importados a mano — contienen datos reales de
# solicitantes (nombres, pedidos), no deberían viajar en el repo.
datos importados/

