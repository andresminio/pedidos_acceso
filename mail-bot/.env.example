# Copiá este archivo a ".env" (sin ".example") en esta misma carpeta y
# completá los valores reales. ".env" está en .gitignore, nunca se sube.

IMAP_HOST=webmail.pjn.gov.ar
IMAP_PORT=993
IMAP_USER=
# Contraseña de la cuenta, o el código de acceso para aplicaciones si
# tiene verificación en dos pasos.
IMAP_PASS=
# El servidor usa un certificado autofirmado (red interna) — el bot no
# verifica el certificado por diseño. Ver README, sección "Certificado SSL".
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
