# Copiá este archivo a mail-bot/.env y completá los valores. Nunca subir
# mail-bot/.env al repo (ya está en .gitignore).

# Webmail institucional (Zimbra vía IMAP) — usuario y contraseña de tu
# propia cuenta, o el código de acceso para aplicaciones si tenés
# verificación en dos pasos activada.
IMAP_HOST=webmail.pjn.gov.ar
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Poné 1 solo para debug si el servidor usa certificado autofirmado.
# IMAP_VERIFY_SSL=1

# Gemini (clasificación de correos) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash  # opcional, fija un modelo en vez de rotar

# Mismo proyecto de Supabase que usa el panel (anon key)
SUPABASE_URL=
SUPABASE_KEY=

# Email de quien responde por Prosecretaría (para etiquetar correctamente
# sus respuestas en la línea de tiempo de cada pedido). Opcional: sin
# configurar, esas respuestas quedan con una etiqueta genérica.
NORA_EMAIL=
