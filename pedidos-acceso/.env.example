# Supabase (público, seguro para el cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Sheets (SOLO server-side, usado en app/api/sync-sheets/route.ts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Pedidos

# Secreto compartido para validar que el webhook de Supabase es legítimo
SYNC_WEBHOOK_SECRET=
