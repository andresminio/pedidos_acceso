# Supabase (público, seguro para el cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Sheets (SOLO server-side, usado en app/api/sync-sheets/route.ts)
# OAuth de tu propia cuenta de Google (ver README) — la org tiene
# bloqueada la creación de claves de service account, así que se usa
# esto en vez de un JSON de service account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Pedidos

# Secreto compartido para validar que el webhook de Supabase es legítimo
SYNC_WEBHOOK_SECRET=
